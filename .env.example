XGR_RPC_URL=https://rpc.xgr.network
XGR_EXPLORER_API_URL=https://explorer.xgr.network/api
MCP_SERVER_NAME=xgr-mcp-gateway
MCP_READONLY=true
MCP_HTTP_PORT=3100

PGRO_HOST=127.0.0.1
PGRO_PORT=5432
PGRO_USER=xgr_reader
PGRO_PASSWORD=
PGRO_DB=xgrscan
PGRO_POOL_MAX=4
PGRO_STATEMENT_TIMEOUT_MS=5000

MCP_OPERATION_STORE_DIR=./data/operations
MCP_OPERATION_PUBLIC_BASE_URL=https://mcp.xgr.network
MCP_PUBLIC_BASE_URL=https://mcp.xgr.network
MCP_OPERATION_DEFAULT_TTL_SECONDS=3600
MCP_OPERATION_MAX_TTL_SECONDS=86400

# Optional advanced override. Defaults to ${MCP_OPERATION_STORE_DIR}/bundle-deploy.
# MCP_BUNDLE_DEPLOY_STORE_DIR=/var/lib/xgr-mcp/operations/bundle-deploy
MCP_XDALA_BUNDLE_DEPLOY_BASE_URL=https://xdala.xgr.network/api/bundle-deploy
MCP_BUNDLE_DEPLOY_DEFAULT_TTL_SECONDS=3600
MCP_BUNDLE_DEPLOY_MAX_TTL_SECONDS=86400

# Mainnet-only autonomous XGR purchase tools. Disabled unless all values below are set exactly.
# These tools create orders only; payment is performed by an external wallet agent or a human.
XGR_PURCHASE_TOOLS_ENABLED=false
XGR_PURCHASE_NETWORK=mainnet
XGR_PURCHASE_API_BASE_URL=https://xgr.network
XGR_PURCHASE_MAX_EUR=249.99

# Optional starter-gas service. Sends exactly 1 XGR from a dedicated service wallet.
# MCP_READONLY still means that user transactions are prepared for local signing. This narrowly
# scoped service-wallet exception never receives or controls user or third-party private keys.
# Use a dedicated, low-balance wallet only. Never reuse an operational treasury key.
XGR_STARTER_GAS_ENABLED=false
XGR_STARTER_GAS_NETWORK=mainnet
XGR_STARTER_GAS_CHAIN_ID=1643
XGR_STARTER_GAS_PRIVATE_KEY=
XGR_STARTER_GAS_MAX_RECIPIENT_BALANCE_XGR=0.1
XGR_STARTER_GAS_MAX_HOURLY_GRANTS=20
XGR_STARTER_GAS_MAX_DAILY_GRANTS=100
XGR_STARTER_GAS_MAX_ATTEMPTS_PER_ADDRESS=2
XGR_STARTER_GAS_RESERVATION_TIMEOUT_SECONDS=600
XGR_STARTER_GAS_DB_PATH=./data/starter-gas-grants-mainnet.sqlite

# Legacy compatibility only: when this JSON path is configured and no SQLite database exists,
# confirmed records are imported once into a sibling .sqlite database.
# XGR_STARTER_GAS_STORE_PATH=./data/starter-gas-grants-mainnet.json
